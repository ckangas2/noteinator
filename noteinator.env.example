# Copy to noteinator.env and fill in. Keep the real file out of git.

# Where incoming_audio/, processed_audio/, failed_audio/ and lab_notebook.db live
NOTEINATOR_BASE_DIR=/home/viridaex/noteinator-data

# Speech to text: parakeet | canary | faster-whisper
NOTEINATOR_ASR=parakeet
# Unload the model after this many idle minutes (0 = always resident)
NOTEINATOR_IDLE_UNLOAD_MINUTES=5

# Direct upload from the phone. Generate with: openssl rand -hex 24
NOTEINATOR_UPLOAD_TOKEN=CHANGE_ME
# Bind to the Tailscale interface so it is not reachable from the open internet.
# Get it with: tailscale ip -4
NOTEINATOR_UPLOAD_HOST=100.x.y.z
NOTEINATOR_UPLOAD_PORT=8765

# Note extraction
OLLAMA_URL=http://127.0.0.1:11434/api/generate
OLLAMA_MODEL=llama3.2
